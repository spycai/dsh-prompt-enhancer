{
  "name": "dsh-prompt-enhancer",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "description": "Composer button beside the model selector that rewrites the drafted message into a professional prompt.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/prompt.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/prompt.test.mjs test/enhance.integration.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
