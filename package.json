{
  "name": "dsh-prompt-enhancer",
  "version": "1.6.2",
  "description": "Composer button beside the model selector that rewrites the drafted message into a professional prompt.",
  "author": "spycai <9680871@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spycai/dsh-prompt-enhancer.git"
  },
  "bugs": {
    "url": "https://github.com/spycai/dsh-prompt-enhancer/issues"
  },
  "homepage": "https://github.com/spycai/dsh-prompt-enhancer#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "composer"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "locale/",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/lib/run-tests.mjs",
    "baseline": "node test/lib/baseline.mjs",
    "baseline:check": "node test/lib/baseline.mjs --outputs test/fixtures/recorded/v1.5.5-proxy.json --compare test/fixtures/recorded/v1.5.4-proxy.json"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
